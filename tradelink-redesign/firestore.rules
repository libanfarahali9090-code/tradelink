rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Helpers
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'kaafiebirr95@gmail.com';
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'pending';
    }

    function isUserActive() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || (getUserRole() in ['owner', 'admin'] && isUserActive()))
      );
    }

    function isManager() {
      return isAdmin() || (isVerifiedUser() && getUserRole() == 'manager' && isUserActive());
    }

    function isTeamMember() {
      return isAdmin() || (isVerifiedUser() && getUserRole() in ['owner', 'admin', 'manager', 'employee'] && isUserActive());
    }

    // -------------------------------------------------------------------------
    // Entity Validation Helpers
    // -------------------------------------------------------------------------
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'phone', 'active', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['owner', 'admin', 'manager', 'employee', 'pending']
        && data.active is bool
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAgent(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'phone', 'languages', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'code', 'name', 'phone', 'whatsapp', 'telegram', 'languages', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 40
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 24
        && data.languages is list && data.languages.size() >= 1 && data.languages.size() <= 3
        && data.status in ['active', 'inactive']
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 24))
        && (!('telegram' in data) || (data.telegram is string && data.telegram.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidListing(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'unit', 'availability', 'stockQty', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'sku', 'name', 'nameSo', 'nameAm', 'category', 'description', 'unit', 'origin',
          'expiryDate', 'photoUrl', 'availability', 'stockQty', 'agentId', 'collectionLocation',
          'warehouseBay', 'stockUpdatedAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 160
        && data.category in ['rice', 'flour', 'sugar', 'cooking_oil', 'dates', 'pasta', 'beans', 'other_food']
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 60
        && data.availability in ['in_stock', 'low_stock', 'out_of_stock']
        && data.stockQty is number && data.stockQty >= 0
        && (!('description' in data) || (data.description is string && data.description.size() <= 1200))
        && (!('collectionLocation' in data) || (data.collectionLocation is string && data.collectionLocation.size() <= 160))
        && (!('stockUpdatedAt' in data) || (data.stockUpdatedAt is string && data.stockUpdatedAt.size() <= 40))
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'name', 'category', 'unit', 'purchasePrice', 'sellingPrice',
          'currency', 'stockQty', 'minStockQty', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'sku', 'name', 'nameSo', 'nameAm', 'category', 'description', 'unit',
          'purchasePrice', 'sellingPrice', 'currency', 'stockQty', 'minStockQty',
          'status', 'photoUrl', 'supplierId', 'supplierName', 'warehouseBay',
          'origin', 'expiryDate', 'agentId', 'collectionLocation', 'stockUpdatedAt',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 160
        && data.category in ['rice', 'flour', 'sugar', 'cooking_oil', 'dates', 'pasta', 'beans', 'other_food']
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 60
        && data.purchasePrice is number && data.purchasePrice >= 0
        && data.sellingPrice is number && data.sellingPrice >= 0
        && data.currency in ['ETB', 'USD']
        && data.stockQty is number && data.stockQty >= 0
        && data.minStockQty is number && data.minStockQty >= 0
        && data.status in ['active', 'inactive', 'archived']
        && (!('sku' in data) || (data.sku is string && data.sku.size() <= 60))
        && (!('nameSo' in data) || (data.nameSo is string && data.nameSo.size() <= 160))
        && (!('nameAm' in data) || (data.nameAm is string && data.nameAm.size() <= 160))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1200))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && (!('supplierId' in data) || (data.supplierId is string && data.supplierId.size() <= 128))
        && (!('supplierName' in data) || (data.supplierName is string && data.supplierName.size() <= 160))
        && (!('warehouseBay' in data) || (data.warehouseBay is string && data.warehouseBay.size() <= 100))
        && (!('origin' in data) || (data.origin is string && data.origin.size() <= 100))
        && (!('expiryDate' in data) || (data.expiryDate is string && data.expiryDate.size() <= 40))
        && (!('agentId' in data) || (data.agentId is string && data.agentId.size() <= 128))
        && (!('collectionLocation' in data) || (data.collectionLocation is string && data.collectionLocation.size() <= 160))
        && (!('stockUpdatedAt' in data) || (data.stockUpdatedAt is string && data.stockUpdatedAt.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'orderCode', 'buyerId', 'buyerName', 'productId', 'productName', 'unit',
          'quantity', 'unitPrice', 'totalAmount', 'currency', 'status', 'paymentStatus',
          'orderDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'orderCode', 'buyerId', 'buyerName', 'productId', 'productName', 'unit',
          'quantity', 'unitPrice', 'totalAmount', 'currency', 'status', 'paymentStatus',
          'orderDate', 'notes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.productId)
        && isValidId(data.buyerId)
        && data.orderCode is string && data.orderCode.size() >= 3 && data.orderCode.size() <= 40
        && data.buyerName is string && data.buyerName.size() >= 2 && data.buyerName.size() <= 160
        && data.productName is string && data.productName.size() >= 2 && data.productName.size() <= 160
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 60
        && data.quantity is number && data.quantity >= 1
        && data.unitPrice is number && data.unitPrice >= 0
        && data.totalAmount is number && data.totalAmount >= 0
        && data.currency in ['ETB', 'USD']
        && data.status in ['pending', 'confirmed', 'processing', 'ready_for_dispatch', 'delivered', 'cancelled']
        && data.paymentStatus in ['unpaid', 'partial', 'paid']
        && data.orderDate is string && data.orderDate.size() >= 4 && data.orderDate.size() <= 40
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrderHistory(data) {
      return data.keys().hasAll(['id', 'orderId', 'fromStatus', 'toStatus', 'actorUid', 'actorName', 'createdAt'])
        && data.keys().hasOnly(['id', 'orderId', 'fromStatus', 'toStatus', 'actorUid', 'actorName', 'note', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.orderId)
        && isValidId(data.actorUid)
        && data.fromStatus is string && data.fromStatus.size() <= 40
        && data.toStatus is string && data.toStatus.size() <= 40
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && (!('note' in data) || (data.note is string && data.note.size() <= 400))
        && data.createdAt is timestamp;
    }

    function isValidSupplier(data) {
      return data.keys().hasAll(['id', 'name', 'contactName', 'phone', 'totalPurchased', 'outstandingBalance', 'onTimeRate', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'contactName', 'phone', 'email', 'city', 'suppliedCategories', 'totalPurchased', 'outstandingBalance', 'onTimeRate', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 160
        && data.contactName is string && data.contactName.size() >= 2 && data.contactName.size() <= 120
        && data.phone is string && data.phone.size() >= 4 && data.phone.size() <= 40
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('suppliedCategories' in data) || (data.suppliedCategories is string && data.suppliedCategories.size() <= 240))
        && data.totalPurchased is number && data.totalPurchased >= 0
        && data.outstandingBalance is number && data.outstandingBalance >= 0
        && data.onTimeRate is number && data.onTimeRate >= 0 && data.onTimeRate <= 100
        && data.status in ['active', 'inactive']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBuyer(data) {
      return data.keys().hasAll(['id', 'businessName', 'contactName', 'phone', 'totalOrders', 'totalSpent', 'outstandingBalance', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'businessName', 'contactName', 'phone', 'email', 'city', 'totalOrders', 'totalSpent', 'outstandingBalance', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 160
        && data.contactName is string && data.contactName.size() >= 2 && data.contactName.size() <= 120
        && data.phone is string && data.phone.size() >= 4 && data.phone.size() <= 40
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && data.totalOrders is number && data.totalOrders >= 0
        && data.totalSpent is number && data.totalSpent >= 0
        && data.outstandingBalance is number && data.outstandingBalance >= 0
        && data.status in ['active', 'inactive']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStockMovement(data) {
      return data.keys().hasAll(['id', 'productId', 'productName', 'type', 'quantityDelta', 'balanceAfter', 'referenceId', 'actorUid', 'actorName', 'createdAt'])
        && data.keys().hasOnly(['id', 'productId', 'productName', 'type', 'quantityDelta', 'balanceAfter', 'referenceId', 'actorUid', 'actorName', 'notes', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.productId)
        && isValidId(data.actorUid)
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 160
        && data.type in ['received', 'issued', 'adjustment', 'transfer']
        && data.quantityDelta is number
        && data.balanceAfter is number && data.balanceAfter >= 0
        && data.referenceId is string && data.referenceId.size() >= 1 && data.referenceId.size() <= 128
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 400))
        && data.createdAt is timestamp;
    }

    function isValidDelivery(data) {
      return data.keys().hasAll(['id', 'orderId', 'orderCode', 'buyerName', 'destination', 'vehiclePlate', 'driverName', 'scheduledDate', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orderId', 'orderCode', 'buyerName', 'destination', 'vehiclePlate', 'driverName', 'scheduledDate', 'status', 'notes', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.orderId)
        && data.orderCode is string && data.orderCode.size() >= 3 && data.orderCode.size() <= 40
        && data.buyerName is string && data.buyerName.size() >= 2 && data.buyerName.size() <= 160
        && data.destination is string && data.destination.size() >= 2 && data.destination.size() <= 160
        && data.vehiclePlate is string && data.vehiclePlate.size() >= 2 && data.vehiclePlate.size() <= 40
        && data.driverName is string && data.driverName.size() >= 2 && data.driverName.size() <= 120
        && data.scheduledDate is string && data.scheduledDate.size() >= 4 && data.scheduledDate.size() <= 40
        && data.status in ['scheduled', 'loading', 'dispatched', 'delivered']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 400))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'txCode', 'type', 'partyName', 'amount', 'currency', 'method', 'status', 'date', 'createdAt'])
        && data.keys().hasOnly(['id', 'txCode', 'type', 'partyId', 'partyName', 'orderId', 'amount', 'currency', 'method', 'status', 'date', 'notes', 'createdAt'])
        && isValidId(data.id)
        && data.txCode is string && data.txCode.size() >= 3 && data.txCode.size() <= 40
        && data.type in ['buyer_payment', 'supplier_payment', 'purchase_expense', 'commission_payment']
        && data.partyName is string && data.partyName.size() >= 2 && data.partyName.size() <= 160
        && (!('partyId' in data) || (data.partyId is string && data.partyId.size() <= 128))
        && (!('orderId' in data) || (data.orderId is string && data.orderId.size() <= 128))
        && data.amount is number && data.amount >= 0
        && data.currency in ['ETB', 'USD']
        && data.method in ['cash', 'bank_transfer', 'other']
        && data.status in ['completed', 'pending']
        && data.date is string && data.date.size() >= 4 && data.date.size() <= 40
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 400))
        && data.createdAt is timestamp;
    }

    function isValidCommissionRecord(data) {
      return data.keys().hasAll(['id', 'orderId', 'orderCode', 'productName', 'saleAmount', 'ratePercent', 'commissionAmount', 'currency', 'payer', 'status', 'date', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orderId', 'orderCode', 'productName', 'saleAmount', 'ratePercent', 'commissionAmount', 'currency', 'payer', 'status', 'date', 'notes', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.orderId)
        && data.orderCode is string && data.orderCode.size() >= 3 && data.orderCode.size() <= 40
        && data.productName is string && data.productName.size() >= 2 && data.productName.size() <= 160
        && data.saleAmount is number && data.saleAmount >= 0
        && data.ratePercent is number && data.ratePercent >= 0
        && data.commissionAmount is number && data.commissionAmount >= 0
        && data.currency in ['ETB', 'USD']
        && data.payer == 'owner'
        && data.status in ['pending', 'paid']
        && data.date is string && data.date.size() >= 4 && data.date.size() <= 40
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 400))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditEvent(data) {
      return data.keys().hasAll(['id', 'actorUid', 'actorName', 'actorRole', 'action', 'category', 'summary', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorUid', 'actorName', 'actorRole', 'action', 'category', 'summary', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.actorUid)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.actorRole is string && data.actorRole.size() <= 40
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 80
        && data.category in ['order', 'payment', 'inventory', 'supplier', 'buyer', 'team', 'settings']
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500
        && data.createdAt is timestamp;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['id', 'businessName', 'warehouseName', 'currency', 'defaultLanguage', 'commissionRatePercent', 'lowStockAlertEnabled', 'updatedAt'])
        && data.keys().hasOnly(['id', 'businessName', 'warehouseName', 'location', 'phone', 'email', 'currency', 'defaultLanguage', 'commissionRatePercent', 'lowStockAlertEnabled', 'orderAlertEnabled', 'paymentAlertEnabled', 'updatedAt'])
        && isValidId(data.id)
        && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 160
        && data.warehouseName is string && data.warehouseName.size() >= 2 && data.warehouseName.size() <= 160
        && data.currency in ['ETB', 'USD']
        && data.defaultLanguage in ['en', 'so', 'am']
        && data.commissionRatePercent is number && data.commissionRatePercent >= 0 && data.commissionRatePercent <= 50
        && data.lowStockAlertEnabled is bool
        && (!('location' in data) || (data.location is string && data.location.size() <= 160))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('orderAlertEnabled' in data) || data.orderAlertEnabled is bool)
        && (!('paymentAlertEnabled' in data) || data.paymentAlertEnabled is bool)
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow write: if isBootstrappedAdmin() && isValidId(adminUid);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || (isOwner(userId) && incoming().role == 'pending' && incoming().active == true));
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().role == existing().role && incoming().active == existing().active && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /products/{productId} {
      // Staff only: this record holds cost prices and supplier data. The public reads public_listings.
      allow get: if isValidId(productId) && isTeamMember();
      allow list: if isTeamMember();
      allow create: if isValidId(productId) && isManager() && isValidProduct(incoming()) && incoming().id == productId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(productId) && isTeamMember() && isValidProduct(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isManager() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['stockQty', 'stockUpdatedAt', 'updatedAt'])
      );
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isTeamMember();
      allow list: if isTeamMember();
      allow create: if isValidId(orderId) && isTeamMember() && isValidOrder(incoming()) && incoming().id == orderId && incoming().createdAt == request.time && incoming().updatedAt == request.time && existsAfter(/databases/$(database)/documents/products/$(incoming().productId));
      allow update: if isValidId(orderId) && isTeamMember() && isValidOrder(incoming()) && incoming().id == existing().id && incoming().orderCode == existing().orderCode && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'quantity', 'unitPrice', 'totalAmount', 'notes', 'productId', 'productName', 'unit', 'buyerId', 'buyerName', 'orderDate', 'updatedAt'])
      );
      allow delete: if isValidId(orderId) && isAdmin();

      match /history/{historyId} {
        allow get: if isValidId(orderId) && isValidId(historyId) && isTeamMember();
        allow list: if isValidId(orderId) && isTeamMember();
        allow create: if isValidId(orderId) && isValidId(historyId) && isTeamMember() && isValidOrderHistory(incoming()) && incoming().id == historyId && incoming().orderId == orderId && incoming().actorUid == request.auth.uid && incoming().createdAt == request.time && existsAfter(/databases/$(database)/documents/orders/$(orderId));
        allow update, delete: if false;
      }
    }

    // Public, cost-free copy of active products. Written by staff alongside every product change.
    match /public_listings/{listingId} {
      allow get, list: if true;
      allow create, update: if isValidId(listingId) && isTeamMember() && isValidListing(incoming()) && incoming().id == listingId && incoming().updatedAt == request.time;
      allow delete: if isValidId(listingId) && isTeamMember();
    }

    // Agent contact details are public on purpose: customers reach agents without an account.
    match /agents/{agentId} {
      allow get: if isValidId(agentId) && (resource.data.status == 'active' || isTeamMember());
      allow list: if resource.data.status == 'active' || isTeamMember();
      allow create: if isValidId(agentId) && isAdmin() && isValidAgent(incoming()) && incoming().id == agentId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(agentId) && isAdmin() && isValidAgent(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(agentId) && isAdmin();
    }

    match /suppliers/{supplierId} {
      allow get: if isValidId(supplierId) && isTeamMember();
      allow list: if isTeamMember();
      allow create: if isValidId(supplierId) && isManager() && isValidSupplier(incoming()) && incoming().id == supplierId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(supplierId) && isManager() && isValidSupplier(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'contactName', 'phone', 'email', 'city', 'suppliedCategories', 'totalPurchased', 'outstandingBalance', 'onTimeRate', 'status', 'updatedAt'])
      );
      allow delete: if isValidId(supplierId) && isAdmin();
    }

    match /buyers/{buyerId} {
      allow get: if isValidId(buyerId) && isTeamMember();
      allow list: if isTeamMember();
      allow create: if isValidId(buyerId) && isTeamMember() && isValidBuyer(incoming()) && incoming().id == buyerId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(buyerId) && isTeamMember() && isValidBuyer(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isManager() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['totalOrders', 'totalSpent', 'outstandingBalance', 'updatedAt'])
      );
      allow delete: if isValidId(buyerId) && isAdmin();
    }

    match /stock_movements/{movementId} {
      allow get: if isValidId(movementId) && isTeamMember();
      allow list: if isTeamMember();
      allow create: if isValidId(movementId) && isTeamMember() && isValidStockMovement(incoming()) && incoming().id == movementId && incoming().actorUid == request.auth.uid && incoming().createdAt == request.time && existsAfter(/databases/$(database)/documents/products/$(incoming().productId));
      allow update, delete: if false;
    }

    match /deliveries/{deliveryId} {
      allow get: if isValidId(deliveryId) && isTeamMember();
      allow list: if isTeamMember();
      allow create: if isValidId(deliveryId) && isTeamMember() && isValidDelivery(incoming()) && incoming().id == deliveryId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(deliveryId) && isTeamMember() && isValidDelivery(incoming()) && incoming().id == existing().id && incoming().orderId == existing().orderId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isManager() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'vehiclePlate', 'driverName', 'scheduledDate', 'destination', 'notes', 'updatedAt'])
      );
      allow delete: if isValidId(deliveryId) && isAdmin();
    }

    match /transactions/{txId} {
      allow get: if isValidId(txId) && isManager();
      allow list: if isManager();
      allow create: if isValidId(txId) && isManager() && isValidTransaction(incoming()) && incoming().id == txId && incoming().createdAt == request.time;
      allow update: if isValidId(txId) && isAdmin() && isValidTransaction(incoming()) && incoming().id == existing().id && incoming().txCode == existing().txCode && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'method', 'notes', 'amount']);
      allow delete: if isValidId(txId) && isAdmin();
    }

    match /commission_ledger/{entryId} {
      allow get: if isValidId(entryId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(entryId) && isValidCommissionRecord(incoming()) && incoming().id == entryId && incoming().createdAt == request.time && incoming().updatedAt == request.time && existsAfter(/databases/$(database)/documents/orders/$(incoming().orderId)) && (
        isAdmin() ||
        (isManager() && incoming().status == 'pending' && incoming().payer == 'owner')
      );
      allow update: if isValidId(entryId) && isAdmin() && isValidCommissionRecord(incoming()) && incoming().id == existing().id && incoming().orderId == existing().orderId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'ratePercent', 'commissionAmount', 'updatedAt']);
      allow delete: if isValidId(entryId) && isAdmin();
    }

    match /audit_events/{eventId} {
      allow get: if isValidId(eventId) && isManager();
      allow list: if isManager();
      allow create: if isValidId(eventId) && isTeamMember() && isValidAuditEvent(incoming()) && incoming().id == eventId && incoming().actorUid == request.auth.uid && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && isTeamMember();
      allow list: if isTeamMember();
      allow create, update: if isValidId(settingId) && isAdmin() && isValidSettings(incoming()) && incoming().id == settingId && incoming().updatedAt == request.time;
      allow delete: if false;
    }
  }
}
